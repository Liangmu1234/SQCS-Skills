import sys
import json
import uuid
import urllib.request

ACCOUNT = "ts_sqcs_knowleged"
PASSWORD = "TS_sqcs_knowleged_123"
SOURCES = ["www", "pmo", "cjg", "cmp", "press", "wwwen", "ts_sqcs_knowleged"]
BASE_URL = "https://api-searchservice.h3c.com/itsearchserve/v1.0/search/getAiResultCommon"
TEST_URL = "https://api-searchservice-ts.h3c.com/itsearchserve/v1.0/search/getAiResultCommon"
USE_TEST = True   # 改用测试环境


def get_url():
    return TEST_URL if USE_TEST else BASE_URL


def build_payload(task, is_deep_search=False, user_id=None, session_id=None, source=None):
    payload = {
        "isDeepSearch": is_deep_search,
        "task": task,
        "source": ",".join(source or SOURCES),
        "user_id": user_id or ACCOUNT,
        "session_id": session_id or str(uuid.uuid4()),
        "application": "zhidao",
        "searchonly": False
    }
    return json.dumps(payload, ensure_ascii=False)


def query(question, is_deep_search=False, verbose=False):
    url = get_url()
    payload = build_payload(question, is_deep_search=is_deep_search)
    data = payload.encode("utf-8")
    headers = {
        "Content-Type": "application/json",
        "Accept": "application/json"
    }
    req = urllib.request.Request(url, data=data, headers=headers, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            raw = resp.read().decode("utf-8")
    except Exception as e:
        return f"[Error] 请求失败: {e}", []
    try:
        result = json.loads(raw)
    except Exception as e:
        return f"[Error] 解析响应失败: {e}\n原始内容: {raw[:500]}", []
    code = result.get("code", -1)
    if code != 0:
        msg = result.get("msg", "未知错误")
        return f"[Error] code={code}, msg={msg}", []
    data_obj = result.get("data", {})
    answer = data_obj.get("answer", "")
    references = data_obj.get("reference_information", []) or []
    if verbose and references:
        ref_info = []
        for ref in references:
            title = ref.get("title", "")
            url2 = ref.get("original_file_path", "")
            ref_info.append(f"- {title}\n  {url2}")
        answer += "\n\n---\n**参考资料：**\n" + "\n".join(ref_info)
    return answer, references


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("用法: python query.py <问题> [--deep]")
        sys.exit(1)
    question = sys.argv[1]
    is_deep = "--deep" in sys.argv
    print(f"问题: {question}")
    print(f"深度思考: {is_deep}")
    print(f"URL: {get_url()}")
    print("---------------")
    answer, refs = query(question, is_deep_search=is_deep, verbose=True)
    print(answer)